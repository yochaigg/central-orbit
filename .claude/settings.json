{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skillspector_guard.py session",
            "timeout": 600,
            "statusMessage": "SkillSpector: scanning skills..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skillspector_guard.py pretool",
            "timeout": 120,
            "statusMessage": "SkillSpector: checking skill..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skillspector_guard.py posttool",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
